{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null && $room.matches(/^[a-z0-9-]{1,24}$/)",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['n', 's'])",
            "n": { ".validate": "newData.isString() && newData.val().length <= 10" },
            "s": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "m": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "c": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)" },
            "p": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100000" },
            "$other": { ".validate": false }
          }
        },
        "race": {
          ".write": "auth != null && $room.matches(/^[a-z0-9-]{1,24}$/) && !newData.child('r').exists()",
          ".validate": "newData.hasChildren(['a', 'b', 't', 'o'])",
          "a": { ".validate": "newData.isNumber()" },
          "b": { ".validate": "newData.isNumber()" },
          "t": { ".validate": "newData.isNumber() && (newData.val() === data.val() || (newData.val() > now - 60000 && newData.val() < now + 60000))" },
          "o": { ".validate": "newData.isString() && newData.val().length <= 2000" },
          "w": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "l": { ".validate": "newData.isString() && newData.val().length <= 8" },
          "r": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() < 7200"
            }
          },
          "$other": { ".validate": false }
        }
      }
    },
    "adRequests": {
      "$id": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['who', 'contact', 't'])",
        "who": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
        "contact": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
        "phone": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "what": { ".validate": "newData.isString() && newData.val().length <= 1000" },
        "t": { ".validate": "newData.val() === now" },
        "$other": { ".validate": false }
      }
    },
    "users": {
      "$uid": {
        "progress": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && auth.token.email_verified === true",
          ".validate": "newData.hasChildren(['money', 't']) && newData.child('money').isNumber()"
        }
      }
    }
  }
}
